{
  "version": {
    "major": 1,
    "minor": 0,
    "patch": 0,
    "postfix": null
  },
  "image": {
    "name": "a2pro-opt3-federated:v1.1.0-base-optlibs"
  },
  "entrypoint": "python src/federated_lm_finetune_main.py",
  "parameters": [
    {
      "name": "federated",
      "title": "Федеративная постановка",
      "description": "Параметры разбиения synthetic token blocks по клиентам.",
      "type": "section",
      "properties": {
        "expanded": true,
        "widgets": [
          {
            "name": "method",
            "type": "enum",
            "title": "Метод",
            "description": "Какие методы ОПТ-3 запустить.",
            "properties": {
              "defaultValue": "all",
              "availableValues": [
                "all",
                "fedavg",
                "async_sgd",
                "async_local_sgd"
              ]
            }
          },
          {
            "name": "clients",
            "type": "int",
            "title": "Клиентов",
            "description": "Число симулированных клиентов.",
            "properties": {
              "defaultValue": 6,
              "minimumValue": 2,
              "exclusiveMinimumValue": false,
              "maximumValue": 64,
              "exclusiveMaximumValue": false,
              "step": 1
            }
          },
          {
            "name": "samplesPerClient",
            "type": "int",
            "title": "Сэмплов на клиента",
            "description": "Число token blocks на каждого клиента.",
            "properties": {
              "defaultValue": 8,
              "minimumValue": 2,
              "exclusiveMinimumValue": false,
              "maximumValue": 256,
              "exclusiveMaximumValue": false,
              "step": 2
            }
          }
        ]
      }
    },
    {
      "name": "data",
      "title": "Данные",
      "description": "Параметры token-level LM задачи.",
      "type": "section",
      "properties": {
        "expanded": true,
        "widgets": [
          {
            "name": "valSamples",
            "type": "int",
            "title": "Validation samples",
            "description": "Число validation token blocks.",
            "properties": {
              "defaultValue": 24,
              "minimumValue": 4,
              "exclusiveMinimumValue": false,
              "maximumValue": 1024,
              "exclusiveMaximumValue": false,
              "step": 4
            }
          },
          {
            "name": "seqLen",
            "type": "int",
            "title": "Sequence length",
            "description": "Длина token block.",
            "properties": {
              "defaultValue": 48,
              "minimumValue": 16,
              "exclusiveMinimumValue": false,
              "maximumValue": 512,
              "exclusiveMaximumValue": false,
              "step": 16
            }
          }
        ]
      }
    },
    {
      "name": "training",
      "title": "Обучение",
      "description": "Параметры FedAvg и async методов.",
      "type": "section",
      "properties": {
        "expanded": true,
        "widgets": [
          {
            "name": "rounds",
            "type": "int",
            "title": "FedAvg раундов",
            "description": "Число синхронных FedAvg раундов.",
            "properties": {
              "defaultValue": 3,
              "minimumValue": 1,
              "exclusiveMinimumValue": false,
              "maximumValue": 200,
              "exclusiveMaximumValue": false,
              "step": 1
            }
          },
          {
            "name": "updates",
            "type": "int",
            "title": "Async updates",
            "description": "Число асинхронных server updates.",
            "properties": {
              "defaultValue": 8,
              "minimumValue": 1,
              "exclusiveMinimumValue": false,
              "maximumValue": 1000,
              "exclusiveMaximumValue": false,
              "step": 1
            }
          },
          {
            "name": "clientsPerRound",
            "type": "int",
            "title": "Клиентов в раунде",
            "description": "Число клиентов в одном FedAvg раунде.",
            "properties": {
              "defaultValue": 3,
              "minimumValue": 1,
              "exclusiveMinimumValue": false,
              "maximumValue": 64,
              "exclusiveMaximumValue": false,
              "step": 1
            }
          },
          {
            "name": "localSteps",
            "type": "int",
            "title": "Локальных шагов",
            "description": "Число локальных SGD шагов на клиенте.",
            "properties": {
              "defaultValue": 1,
              "minimumValue": 1,
              "exclusiveMinimumValue": false,
              "maximumValue": 20,
              "exclusiveMaximumValue": false,
              "step": 1
            }
          },
          {
            "name": "batchSize",
            "type": "int",
            "title": "Batch size",
            "description": "Размер локального mini-batch.",
            "properties": {
              "defaultValue": 2,
              "minimumValue": 1,
              "exclusiveMinimumValue": false,
              "maximumValue": 64,
              "exclusiveMaximumValue": false,
              "step": 1
            }
          },
          {
            "name": "lr",
            "type": "float",
            "title": "Local LR",
            "description": "Learning rate для FedAvg и Async-Local SGD.",
            "properties": {
              "defaultValue": 0.0005,
              "minimumValue": 0.000001,
              "exclusiveMinimumValue": false,
              "maximumValue": 0.1,
              "exclusiveMaximumValue": false,
              "step": 0.0001
            }
          },
          {
            "name": "asyncLr",
            "type": "float",
            "title": "Async LR",
            "description": "Learning rate для AsyncSGD.",
            "properties": {
              "defaultValue": 0.0002,
              "minimumValue": 0.000001,
              "exclusiveMinimumValue": false,
              "maximumValue": 0.1,
              "exclusiveMaximumValue": false,
              "step": 0.0001
            }
          },
          {
            "name": "seed",
            "type": "int",
            "title": "Seed",
            "description": "Seed генерации данных и client sampling.",
            "properties": {
              "defaultValue": 123,
              "minimumValue": 0,
              "exclusiveMinimumValue": false,
              "maximumValue": 1000000,
              "exclusiveMaximumValue": false,
              "step": 1
            }
          }
        ]
      }
    }
  ],
  "inputs": [
    {
      "name": "in_model",
      "title": "Исходная LM",
      "description": "HF-compatible checkpoint causal LM из хранилища A2.Pro.",
      "required": true,
      "type": "checkpoint",
      "properties": {
        "supportedModels": [
          {
            "workspace": "optimization/lm-finetune",
            "arch": "hf-causal-lm",
            "framework": "torch:2.10.0"
          }
        ]
      }
    }
  ],
  "outputs": [
    {
      "name": "out_model",
      "title": "Федеративно дообученная LM",
      "description": "Checkpoint лучшей server model по validation loss.",
      "alwaysExpected": true,
      "type": "checkpoint-collection",
      "properties": {
        "exportedToWorkspaces": [
          "optimization/lm-finetune"
        ]
      }
    },
    {
      "name": "out_metrics",
      "title": "Метрики федеративного LM-дообучения",
      "description": "CSV/JSON/Markdown и график validation loss по FedAvg/AsyncSGD/Async-LocalSGD.",
      "alwaysExpected": true,
      "type": "artifact",
      "properties": {}
    }
  ],
  "resources": {
    "supportedUnits": [
      {
        "type": "GPU",
        "minimum": 1,
        "maximum": null,
        "replicas": 1,
        "step": 1,
        "sharedMemory": 1024,
        "memorySize": 8192,
        "launchTypes": [
          "job"
        ],
        "properties": {
          "unitMemorySize": 8192,
          "frameworks": [
            "cuda"
          ],
          "cpuNumberPerUnit": 4
        }
      }
    ]
  }
}
